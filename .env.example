# Flask Environment & Secrets
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
JWT_SECRET=dev-jwt-secret-change-in-production-min-32-chars

# Database URL:
# Local dev default (SQLite): sqlite:///hotel_ekdant.db
# Production (Render/Postgres): postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///hotel_ekdant.db

# Optional Redis URL for multi-worker Socket.IO scale:
REDIS_URL=

# Initial Owner Setup
INITIAL_OWNER_PASSWORD=ChangeMeEkdant2026!

# Network & Host
PORT=5001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Timezone
TZ=Asia/Kolkata

# Uploads directory
UPLOAD_FOLDER=backend/uploads

# Sentry DSN (optional)
SENTRY_DSN=
